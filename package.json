{
  "name": "malang-pet",
  "version": "1.0.0",
  "description": "바탕화면에서 도트 말랑이를 키우는 다마고치 같은 데스크톱 펫",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "license": "MIT",
  "build": {
    "appId": "com.malangpet.app",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "fonts/**"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "MalangPet-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
