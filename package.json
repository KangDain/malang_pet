{
  "name": "malang-pet",
  "version": "1.8.2",
  "description": "바탕화면에서 도트 말랑이를 키우는 다마고치 같은 데스크톱 펫",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "release": "electron-builder --win nsis portable --publish always"
  },
  "license": "MIT",
  "build": {
    "appId": "com.malangpet.app",
    "compression": "maximum",
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "rpg.js",
      "fonts/**",
      "vendor/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "MalangPet.exe"
    },
    "nsis": {
      "artifactName": "MalangPet-Setup.exe",
      "oneClick": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "말랑이 키우기",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KangDain",
        "repo": "malang_pet",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "peerjs": "^1.5.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
