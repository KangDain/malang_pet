{
  "name": "malang-pet",
  "version": "1.2.0",
  "description": "바탕화면에서 도트 말랑이를 키우는 다마고치 같은 데스크톱 펫",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "license": "MIT",
  "build": {
    "appId": "com.malangpet.app",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "fonts/**",
      "vendor/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "MalangPet-${version}.exe"
    },
    "nsis": {
      "artifactName": "MalangPet-Setup-${version}.exe",
      "oneClick": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "말랑이 키우기",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "peerjs": "^1.5.4"
  }
}
